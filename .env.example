# ============================================================================
# Cybersecurity Paper RAG — Environment Configuration (TEMPLATE)
#
# Copy this file to `.env` and customize. Never commit `.env`.
#
# This file is organized into clear sections:
#   1. LLM_PROVIDER      — which LLM backend to use (ollama cloud / local / openai)
#   2. LLM_MODEL          — the model name for chat / analysis / summarization
#   3. EMBEDDING_PROVIDER — which embedding backend to use
#   4. EMBEDDING_MODEL    — the embedding model name
#   5. RAG                — retrieval tuning
#   6. CHUNKING           — document splitting
#   7. STORAGE / OCR / FLASK / LOGGING
#
# Switching providers only requires changing the *_PROVIDER and *_MODEL
# values; the rest of the application picks them up automatically.
# ============================================================================


# ============================================================================
# 1. LLM PROVIDER
# ============================================================================
# Which LLM backend to use. The application supports:
#
#   ollama       — Ollama (local daemon or Ollama Cloud)
#                  Local:  `ollama serve` + pull a model
#                  Cloud:  `ollama signin` then use any *:cloud model
#   openai       — OpenAI-compatible HTTP API (works with OpenAI, Azure,
#                  vLLM, llama.cpp server, etc.)
#
# Set OPENAI_API_KEY for OpenAI; for self-hosted OpenAI-compatible APIs
# also set OPENAI_BASE_URL.
LLM_PROVIDER=ollama


# ============================================================================
# 2. LLM MODEL
# ============================================================================
# Model identifier passed to the chosen provider.
#
# ---- Ollama Cloud (recommended for CPU laptops) ----
# Requires `ollama signin`. Runs on Ollama's hosted datacenter hardware
# (data is not retained per Ollama's privacy policy). ~3-10s/agent
# regardless of prompt size.
#
#   LLM_MODEL=minimax-m3:cloud            # RECOMMENDED — strong reasoning model
#   LLM_MODEL=gpt-oss:120b-cloud          # OpenAI OSS reasoning model
#   LLM_MODEL=gpt-oss:20b-cloud           # smaller OpenAI OSS
#   LLM_MODEL=qwen3-coder:480b-cloud      # Qwen 3 Coder 480B
#   LLM_MODEL=deepseek-v3.1:671b-cloud    # DeepSeek V3.1
#
# ---- Ollama local (for machines with a GPU) ----
# Requires the model to be pulled (`ollama pull <model>`) and the daemon
# running (`ollama serve`). Speeds shown are on Intel i7-1065G7 (no GPU):
#
#   LLM_MODEL=qwen3.5:2b                  # ~63s/agent — small, needs think=False
#   LLM_MODEL=qwen3.5:4b                  # ~30s/agent — reasoning, needs think=False
#   LLM_MODEL=qwen2.5-coder:7b-instruct   # ~30s/agent — reliable JSON
#   LLM_MODEL=qwen2.5-coder:14b-instruct  # strong code/JSON (needs more RAM)
#   LLM_MODEL=gemma3:4b                   # ~130s/agent — slow on CPU
#   LLM_MODEL=llama3.1:8b                 # minutes — slow on CPU
#
# ---- OpenAI / OpenAI-compatible ----
# Set LLM_PROVIDER=openai and use a model name like gpt-4o-mini.
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=                       # leave empty for OpenAI proper
#                                           # or set to https://api.openai.com/v1
LLM_MODEL=minimax-m3:cloud

# ---- Common settings for all providers ----
TEMPERATURE=0
# Hard timeout (seconds) per chat call. Cloud inference typically responds
# in 3-10s; local CPU models may need 240-600s. If a call doesn't return
# in this time, the agent fails fast and uses safe defaults.
LLM_TIMEOUT_SECONDS=240
# Max papers processed at the same time. Each paper runs 4 analysis
# agents in parallel, so this bounds concurrent LLM requests to ~4x.
# Keep it low for cloud models (they rate-limit above ~12 concurrent).
PAPER_CONCURRENCY=3

# Hard cap on output tokens per call. The SolutionAgent returns 8 content
# fields, so it needs more headroom than the other agents — 2048 was
# truncating its JSON mid-object. 4096 is safe for structured outputs.
LLM_NUM_PREDICT=4096
# Transient-failure retries (HTTP 429 rate limits, 5xx, connection resets).
# Cloud models enforce a concurrency limit; without retries a bulk upload
# can leave blank columns in the results table.
LLM_MAX_RETRIES=5
# Base seconds for exponential backoff between those retries
# (actual delay = backoff^attempt, capped at 60s, with jitter).
LLM_RETRY_BACKOFF=2.0

# Ollama daemon URL (only used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI credentials (only used when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=


# ============================================================================
# Specialized LLM roles (override per-task models)
# ============================================================================
# Set any of these to override LLM_MODEL for that role. Leave empty to
# fall back to LLM_MODEL. Useful when, e.g., a small model handles
# classification but a larger one handles summarization.
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_CYBERSECURITY=
LLM_MODEL_SOLUTION=
LLM_MODEL_METADATA=
LLM_MODEL_QA=


# ============================================================================
# 3. EMBEDDING PROVIDER
# ============================================================================
# Which embedding backend to use. Three providers supported:
#
#   ollama              — local Ollama embeddings (default)
#   sentence_transformers — local HuggingFace sentence-transformers
#   openai              — OpenAI embeddings API
#
# Switch by changing EMBEDDING_PROVIDER below.
EMBEDDING_PROVIDER=ollama


# ============================================================================
# 4. EMBEDDING MODEL
# ============================================================================
# Embedding model identifier passed to the chosen provider.
#
# ---- Ollama embeddings (default) ----
#   EMBEDDING_MODEL=embeddinggemma:latest       # RECOMMENDED — 300M, 768-dim
#   EMBEDDING_MODEL=nomic-embed-text            # 82M, 768-dim, fast
#   EMBEDDING_MODEL=mxbai-embed-large           # 335M, 1024-dim
#   EMBEDDING_MODEL=all-minilm                  # 22M, 384-dim, tiny
#   EMBEDDING_MODEL=qwen3-embedding             # up to 8B, strongest
#   EMBEDDING_MODEL=snowflake-arctic-embed2     # 568M, multilingual
#
# ---- sentence-transformers (local HuggingFace) ----
# Set EMBEDDING_PROVIDER=sentence_transformers and pick a model:
#   EMBEDDING_PROVIDER=sentence_transformers
#   EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384-dim, fast
#   EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2  # 768-dim, stronger
#
# ---- OpenAI embeddings ----
# Set EMBEDDING_PROVIDER=openai and pick a model:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_MODEL=text-embedding-3-large
#   OPENAI_EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=embeddinggemma:latest

# Ollama daemon URL for embeddings (only used when EMBEDDING_PROVIDER=ollama).
# Defaults to OLLAMA_BASE_URL if not set explicitly here.
# OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434

# OpenAI embeddings API key (only used when EMBEDDING_PROVIDER=openai).
OPENAI_EMBEDDING_API_KEY=


# ============================================================================
# 5. RAG (Retrieval-Augmented Generation)
# ============================================================================
# TOP_K=6 keeps agent prompts rich (6 chunks × ~2000 chars ≈ 12K chars
# of retrieved context). Tuned for cloud LLM (minimax-m3:cloud).
# For local CPU models, drop to TOP_K=3.
TOP_K=6
# Minimum cosine-similarity score for a chunk to be retrieved. 0.0 = no
# threshold (return all top_k). Raise to filter out irrelevant chunks.
SCORE_THRESHOLD=0.0


# ============================================================================
# 6. CHUNKING
# ============================================================================
# CHUNK_SIZE=2000 chars per chunk. Larger chunks preserve semantic
# coherence across long technical passages. Cloud models handle ~12K
# tokens of retrieved context comfortably (TOP_K=6 × 2000 chars).
# For local CPU models, drop to CHUNK_SIZE=800.
CHUNK_SIZE=2000
# CHUNK_OVERLAP=400 chars (20% of chunk size). Maintains context at
# chunk boundaries without redundancy.
CHUNK_OVERLAP=400


# ============================================================================
# 7. STORAGE
# ============================================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
SQLITE_PATH=./data/app.sqlite


# ============================================================================
# 8. OCR (opt-in)
# ============================================================================
# Enable only if you have scanned PDFs without extractable text. Requires
# Tesseract installed on the system.
OCR_ENABLED=false
OCR_MIN_CHARS_PER_PAGE=50
TESSERACT_CMD=


# ============================================================================
# 9. FLASK
# ============================================================================
MAX_UPLOAD_MB=2048
SECRET_KEY=change-me


# ============================================================================
# 10. LOGGING
# ============================================================================
LOG_LEVEL=INFO
