# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.installed.cfg
*.egg

# ===== Virtual envs =====
venv/
.venv/
env/
.env/
ENV/

# ===== Distribution / build =====
build/
dist/
wheels/
*.whl

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== Local Ollama scratch / smoke-test scripts =====
# Keep the user's ad-hoc ollama experiments out of version control.
ollama_test/
ollama/

# ===== Project runtime data =====
# All runtime data should be excluded. The directory itself is kept
# in version control via .gitkeep so the structure is reproducible.
data/*
!data/.gitkeep

# ===== Logs =====
*.log
logs/

# ===== Test / coverage =====
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.cache/

# ===== Local secrets =====
.env
.env.local
*.pem
*.key
